# Plantilla de variables de entorno.
# Copiar a .env.local y llenar con los valores reales.
# NUNCA escribir estos valores en el codigo fuente ni commitear .env.local.

# --- Airtable: Sirius Asistencia Eventos (/asistencia) ---
AIRTABLE_BASE_ID_SIRIUS_ASISTENCIA_EVENTOS=
AIRTABLE_API_KEY_SIRIUS_ASISTENCIA_EVENTOS=
# Opcionales: solo si los nombres de tabla cambian en Airtable
# AIRTABLE_TABLE_ASISTENCIA_EVENTOS=Eventos
# AIRTABLE_TABLE_ASISTENCIA_PERSONAS=Personas
# AIRTABLE_TABLE_ASISTENCIA_INSCRIPCIONES=Inscripciones
# AIRTABLE_TABLE_ASISTENCIA_CONSENTIMIENTOS=Consentimientos

# --- Airtable: Sirius CRM (/palma, QR del hablador comercial) ---
# Los leads de feria viven en la tabla "Leads Feria" de la base Sirius CRM,
# al lado de Visitas y Casos.
AIRTABLE_BASE_ID_SIRIUS_CRM=
AIRTABLE_API_KEY_SIRIUS_CRM=
# Opcional: solo si el nombre de la tabla en Airtable no es "Leads Feria"
# AIRTABLE_TABLE_LEADS_FERIA=Leads Feria
# Opcionales: para reutilizar el mismo flujo en otra feria
# PALMA_EVENTO_CODIGO=CONF-PALMA-2026
# PALMA_EVENTO_NOMBRE=Conferencia Internacional de Palma de Aceite 2026
# PALMA_EVENTO_FECHA=Septiembre de 2026
# PALMA_VERSION_POLITICA=2026-09

# --- Airtable: Sirius Remisiones Core (/api/dashboard-bioinsumos) ---
AIRTABLE_BASE_ID_SIRIUS_REMISIONES_CORE=
AIRTABLE_API_KEY_SIRIUS_REMISIONES_CORE=
AIRTABLE_TABLE_REMISIONES=
AIRTABLE_TABLE_PRODUCTOS_REMITIDOS=
DASHBOARD_BIOINSUMOS_CLIENTE_ID=

# --- Airtable: Sirius Nomina Core ---
AIRTABLE_BASE_ID_SIRIUS_NOMINA_CORE=
AIRTABLE_API_KEY_SIRIUS_NOMINA_CORE=
AIRTABLE_TABLE_NOMINA_PERSONAL=
AIRTABLE_TABLE_NOMINA_AREAS=
AIRTABLE_TABLE_NOMINA_ROLES=
AIRTABLE_TABLE_NOMINA_SISTEMAS_APLICACIONES=

# --- Claude (dictado por voz en /palma) ---
# Sin esta llave el boton de microfono responde que el dictado no esta
# disponible y el formulario escrito sigue funcionando normal.
ANTHROPIC_API_KEY=

# --- Correo (formulario de contacto) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=
